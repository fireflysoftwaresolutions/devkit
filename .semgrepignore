# What Semgrep skips in this repository. Without this file Semgrep applies its built-in list, which also skips test/
# and tests/: devkit's tests hold fixtures, scripts and hook payloads that run on the developer's machine, so the
# scans cover them on purpose. Only build output, caches and vendored files are left out.

# Build output
dist/
build/

# Caches
__pycache__/
*.pyc
.ruff_cache/
.pytest_cache/
.mypy_cache/
.playwright/

# Vendored and installed dependencies
node_modules/
vendor/
.venv/
venv/
*.min.js

# Semgrep's own rules folder and logs
.semgrep/
.semgrep_logs/

# Pieces that are not programs on their own: the dashboard script's first and last parts (one block across
# app.js, the sections and boot.js) and the pipeline templates with their placeholders. The qualification gate
# (scripts/security_corpus.py) scans the assembled dashboard and the rendered pipelines instead, and its raw scan
# still reads these files with no ignore list.
lib/devkit/web/app.js
lib/devkit/web/boot.js
templates/ci/**/*.yml
templates/ci/**/*.yaml
