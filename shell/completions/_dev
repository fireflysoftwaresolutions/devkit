#compdef dev
# zsh completion for devkit's `dev` command.

_dev() {
  local -a cmds projects sub
  cmds=(
    'ls:List projects'
    'go:Print a project path'
    'status:Project status'
    'clone:Clone into ~/Development/<owner>/<repo>'
    'new:Start a new project'
    'adopt:Move a repo into the canonical layout'
    'open:Open a project in your editor'
    'claude:Start Claude Code in a project'
    'codex:Start Codex in a project'
    'handoff:Show or edit a handoff note'
    'dashboard:Open the live dashboard'
    'overview:Portfolio digest'
    'standup:Recent work'
    'initiative:Cross-project initiatives'
    'task:Project or initiative tasks'
    'note:Project metadata'
    'plan:Versioned plans and specs'
    'team:Who is working on what'
    'progress:Live progress of agent work'
    'crew:The crew of specialist agents'
    'time:How long things take'
    'report:Status report'
    'lesson:Lessons learned'
    'jobs:Scheduled jobs'
    'audit:The audit trail'
    'sleep:Consolidate and forget lessons and old records'
    'delivery:Delivery policy'
    'files:Compact tree'
    'find:Find files'
    'grep:Search code'
    'diff:Token-light git diff'
    'rm:Move to the Trash, with undo'
    'mv:Move safely'
    'cp:Copy safely'
    'stubs:Unfinished work'
    'wt:Manage worktrees'
    'branch:Branches from an up-to-date main'
    'commit:Conventional Commit'
    'rebase:Rebase on main'
    'push:Push with local CI evidence'
    'pr:Pull requests'
    'run:CI runs'
    'release:Tag and publish by the policy'
    'issue:Issues'
    'ci:What CI runs, CI status, audit and init'
    'test:Failed tests first, then the blast radius'
    'calver:CalVer version'
    'sec:Security scan'
    'docs:Check documentation'
    'diagram:Branded SVG diagrams'
    'canary:Instruction-compliance report'
    'sync:Refresh map and notes, push handoff repo'
    'gc:Reclaim disk safely'
    'du:Disk usage report'
    'setup:Setup wizard'
    'doctor:Verify the setup'
    'agents:Claude Code and Codex status, self-tests and rules'
    'config:Agent settings policy'
    'guard:Simulate a guard decision'
    'plugin:Validate the devkit plugin'
    'desktop:Claude Desktop extension'
    'install:Pin devkit and apply its configuration'
    'update:Update devkit to the newest release'
    'docker:Docker on Colima'
    'version:Show version'
    'help:Show help'
  )
  if (( CURRENT == 2 )); then
    _describe 'command' cmds
    return
  fi
  case "${words[2]}" in
    go|status|open|handoff|claude|codex|ci)
      projects=(${(f)"$(dev __complete projects 2>/dev/null)"})
      _describe 'project' projects ;;
    wt)
      if (( CURRENT == 3 )); then
        sub=('new:Create a managed worktree' 'ls:List worktrees' 'rm:Remove a worktree safely')
        _describe 'worktree command' sub
      elif [[ "${words[3]}" == rm ]]; then
        local -a br; br=(${(f)"$(dev __complete branches 2>/dev/null)"}); _describe 'branch' br
      fi ;;
    task)
      if (( CURRENT == 3 )); then
        sub=('add:Create a work item' 'start:Claim and start' 'claim:Claim and start' 'release:Give the lock back'
             'done:Mark done' 'reopen:Back to todo after done or cancel' 'block:Mark blocked' 'unblock:Back to work'
             'cancel:Cancel' 'move:Move between Now, Next and Later' 'edit:Change title, description, priority or due date'
             'delegate:Assign to a teammate' 'link:Count toward an initiative' 'show:Fields, description and history'
             'history:The changelog' 'ls:Open items')
        _describe 'task verb' sub
      else
        _arguments '*--why[the reason, recorded in the changelog]:reason:' '*-p[project]:project:' '*-i[initiative]:initiative:'
      fi ;;
    progress)
      if (( CURRENT == 3 )); then
        sub=('start:Start a run' 'step:Close a finished step' 'note:Update while a step runs' 'add:Add a step'
             'assign:Hand a step to a crew member' 'begin:Start a step in parallel' 'reopen:Undo a wrong close'
             'skip:Skip a step on purpose' 'block:The run is blocked' 'done:The run is finished'
             'history:Every step change' 'time:How long things take')
        _describe 'progress command' sub
      else
        case "${words[3]}" in
          assign) _arguments '--to[the crew member]:member:' '--scope[the files it owns]:globs:' '--why[assign a member the RACI does not make Responsible]:reason:' ;;
          done) _arguments '--next[what comes next]:next:' '--check[the evidence]:evidence:' '--step[which step]:step:' '--force[skip the safety checks]' '--why[end without an Accountable approval]:reason:' ;;
          step|block) _arguments '--next[what comes next]:next:' '--check[the evidence]:evidence:' '--step[which step]:step:' '--force[skip the safety checks]' ;;
          start) _arguments '--plan[steps with estimates]:plan:' '--estimate[total estimate]:estimate:' '--steps[number of steps]:steps:' '--mode[who takes decisions]:mode:(guided auto)' ;;
          reopen|skip|add) _arguments '--why[the reason]:reason:' ;;
        esac
      fi ;;
    crew)
      if (( CURRENT == 3 )); then
        sub=('graph:The live session as one graph' 'raci:Who does, approves, is consulted and informed'
             'rules:Every crew rule and its check' 'show:One member' 'brief:A ready brief for a member'
             'route:Who should do a task' 'delegate:A step for another member' 'decline:Hand a step back'
             'next:Who to launch now' 'ask:A question or a decision' 'answer:Answer a message' 'inbox:Messages for you'
             'mode:Guided or auto' 'decide:Record the developer'"'"'s answer' 'decisions:This run'"'"'s decisions'
             'set:Change a member for the whole team' 'history:The team'"'"'s changes to the crew'
             'sync:Regenerate the Claude agents')
        _describe 'crew command' sub
      else
        case "${words[3]}" in
          graph) _arguments '--latest[the newest running run on this Mac]' '(--json)--mermaid[a Mermaid flowchart]' '(--mermaid)--json[nodes and edges]' ;;
          raci) _arguments '--set[change a row: "R=… A=… C=… I=…"]:assignments:' '--why[the reason]:reason:' '--markdown[the matrix as a Markdown table]' ;;
          set)
            if (( CURRENT == 5 )); then
              sub=(name title role summary personality goal returns use_when not_for skills procedure devkit done_when keywords tools tier)
              _describe 'field' sub
            else
              _arguments '--why[the reason, kept in the crew history]:reason:'
            fi ;;
          mode) (( CURRENT == 4 )) && { sub=(guided auto); _describe 'mode' sub; } ;;
          sync) _arguments '--check[report differences only]' ;;
        esac
      fi ;;
    agents)
      if (( CURRENT == 3 )); then
        sub=('status:Installed, signed in, plan, quota' 'test:A live self-test' 'rules:devkit'"'"'s global rules for agents')
        _describe 'agents command' sub
      elif [[ "${words[3]}" == rules ]]; then
        _arguments '--section[one section, by number or title words]:section:'
      elif (( CURRENT == 4 )); then
        sub=(claude codex all); _describe 'agent' sub
      fi ;;
    dashboard)
      _arguments '--no-open[print the one-time link]' '--status[is a server running?]' '--stop[stop the server]' \
        '--export[write a static copy to a file]:file:_files' '--path[write the static copy and print its path]' ;;
    desktop)
      (( CURRENT == 3 )) && { sub=('pack:Build the extension bundle' 'status:What Claude Desktop has installed'); _describe 'desktop command' sub; } ;;
    docker)
      local -a act; act=(up down status prune autostart-on autostart-off); _describe 'action' act ;;
    install)
      _arguments \
        '(--version --unverified --why)--only[re-apply steps from the installed copy]:steps:_values -s , step config tools cli git handoff instructions skills claude codex desktop docker docs launchd' \
        '(--only --unverified --why)--version[switch to a pinned copy kept from an earlier install]:version:_files -W $HOME/.local/share/devkit/releases -/' \
        '(--only --version)--unverified[pin a commit that is neither a release nor tested]' \
        '(--only --version)--why[the reason for --unverified]:reason:' ;;
    gc)
      _arguments '--apply[reclaim]' '-y[no prompt]' '-v[list kept items]' ;;
    adopt)
      _files -/ ;;
  esac
}

_dev "$@"
