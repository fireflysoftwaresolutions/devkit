# devkit toolchain. `dev setup` and `dev install --only tools` install the base groups (core, docker, agents, docs,
# security) plus the stacks, git hosts and clouds chosen in the wizard (config: stacks, hosts, clouds).
# @core
brew "git"
brew "gh"
brew "jq"
brew "ripgrep"
brew "fd"            # gitignore-aware file listing (dev find)
brew "ast-grep"      # structural code search (dev grep --ast)
brew "difftastic"    # syntax-aware diffs (dev diff --syntax)
brew "git-cliff"     # release notes from Conventional Commits (dev release)
brew "fzf"
brew "python"
brew "node"
# @python
brew "uv"
# @node
brew "pnpm"
# @java
brew "openjdk"
