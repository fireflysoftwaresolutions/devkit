{
  "about": "Test vectors for lib/devkit/visual/redact.cjs: control stripping (R71), URL redaction (R15) and route patterns. A value written as {\"join\": [parts]} is the parts joined, so no secret scanner reads this file as holding a token. tests/test_visual_redact.py runs every case through call.cjs.",
  "strip": [
    {"name": "plain text is kept", "text": "Invoices for October", "expect": {"text": "Invoices for October", "removed": 0}},
    {"name": "tab and newline are kept", "text": "a\tb\nc", "expect": {"text": "a\tb\nc", "removed": 0}},
    {"name": "an OSC 52 escape loses ESC and BEL", "text": "\u001b]52;c;aGk=\u0007after", "expect": {"text": "]52;c;aGk=after", "removed": 2}},
    {"name": "NUL, carriage return, vertical tab, form feed and DEL go", "text": "a\u0000b\r\nc\u000bd\u000ce\u007f", "expect": {"text": "ab\ncde", "removed": 5}},
    {"name": "C1 controls go", "text": "a\u0080b\u0085c\u009bd\u009f", "expect": {"text": "abcd", "removed": 4}},
    {"name": "every bidirectional control goes", "text": "a؜b‎c‏d‪e‫f‬g‭h‮i⁦j⁧k⁨l⁩m", "expect": {"text": "abcdefghijklm", "removed": 12}},
    {"name": "no-break space, zero-width space, accents and symbols stay", "text": "café ​✓  ", "expect": {"text": "café ​✓  ", "removed": 0}},
    {"name": "null stays null", "text": null, "expect": {"text": null, "removed": 0}}
  ],
  "redactUrl": [
    {"name": "a parameter named t", "url": "http://127.0.0.1:8123/auth?t=abc123&to=/now",
     "expect": {"url": "http://127.0.0.1:8123/auth?t=[redacted]&to=/now", "params": ["t"]}},
    {"name": "a relative link with a token", "url": "/reports?token=abc123",
     "expect": {"url": "/reports?token=[redacted]", "params": ["token"]}},
    {"name": "names that contain a secret word, in any letter case", "url": "https://files.example/o?X-Amz-Signature=a&X-Amz-Credential=b&api_key=k&client_secret=s&page=2",
     "expect": {"url": "https://files.example/o?X-Amz-Signature=[redacted]&X-Amz-Credential=[redacted]&api_key=[redacted]&client_secret=[redacted]&page=2",
                "params": ["X-Amz-Signature", "X-Amz-Credential", "api_key", "client_secret"]}},
    {"name": "every word of the rule, and t and ticket in capitals", "url": "/x?sig=1&passwd=2&oauth_state=3&sessionid=4&code=5&jwt=6&keyword=7&postcode=8&T=9&Ticket=10",
     "expect": {"url": "/x?sig=[redacted]&passwd=[redacted]&oauth_state=[redacted]&sessionid=[redacted]&code=[redacted]&jwt=[redacted]&keyword=[redacted]&postcode=[redacted]&T=[redacted]&Ticket=[redacted]",
                "params": ["sig", "passwd", "oauth_state", "sessionid", "code", "jwt", "keyword", "postcode", "T", "Ticket"]}},
    {"name": "ordinary parameters stay as written", "url": "/invoices?q=hello%20world&sort=asc&tab=open&to=/now",
     "expect": {"url": "/invoices?q=hello%20world&sort=asc&tab=open&to=/now", "params": []}},
    {"name": "a percent-encoded name is matched decoded", "url": "/x?api%5Fkey=zzz", "expect": {"url": "/x?api%5Fkey=[redacted]", "params": ["api%5Fkey"]}},
    {"name": "an empty value has nothing to redact", "url": "/x?token=&a=1", "expect": {"url": "/x?token=&a=1", "params": []}},
    {"name": "user info", "url": "https://alice:hunter2@example.com:8443/x", "expect": {"url": "https://[redacted]@example.com:8443/x", "params": []}},
    {"name": "user info without a password", "url": "ftp://alice@example.com/", "expect": {"url": "ftp://[redacted]@example.com/", "params": []}},
    {"name": "a fragment that is not a route", "url": "https://h.example/p#access_token=t&state=1", "expect": {"url": "https://h.example/p#[redacted]", "params": []}},
    {"name": "an empty fragment stays", "url": "/p#", "expect": {"url": "/p#", "params": []}},
    {"name": "a fragment of one plain word stays", "url": "http://127.0.0.1:4200/invoices#export", "expect": {"url": "http://127.0.0.1:4200/invoices#export", "params": []}},
    {"name": "a plain word with digits and a hyphen stays", "url": "/docs#section-2", "expect": {"url": "/docs#section-2", "params": []}},
    {"name": "a fragment of one token-shaped word is redacted", "url": "/p#a8Kd2Lq9ZxRt4Vb7NwYcE3", "expect": {"url": "/p#[redacted]", "params": []}},
    {"name": "a fragment of two words is redacted", "url": "/p#two%20words", "expect": {"url": "/p#[redacted]", "params": []}},
    {"name": "a plain word such as state stays", "url": "/p#state", "expect": {"url": "/p#state", "params": []}},
    {"name": "a word followed by an equals sign is redacted", "url": "/p#code=", "expect": {"url": "/p#[redacted]", "params": []}},
    {"name": "a hash route stays", "url": "http://127.0.0.1:4200/#/invoices?tab=open", "expect": {"url": "http://127.0.0.1:4200/#/invoices?tab=open", "params": []}},
    {"name": "a hash route's query follows the parameter rule", "url": "http://127.0.0.1:4200/#/login?token=abc123&next=/home",
     "expect": {"url": "http://127.0.0.1:4200/#/login?token=[redacted]&next=/home", "params": ["token"]}},
    {"name": "a JWT path segment, both parameters, and the fragment",
     "url": {"join": ["/reset/", "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9", ".", "eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4ifQ", ".", "SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c", "?X-Amz-Signature=a&api_key=k#access_token=t"]},
     "expect": {"url": "/reset/[redacted]?X-Amz-Signature=[redacted]&api_key=[redacted]#[redacted]", "params": ["X-Amz-Signature", "api_key"]}},
    {"name": "a JWT segment inside a hash route",
     "url": {"join": ["/#/reset/", "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9", ".", "eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4ifQ", "."]},
     "expect": {"url": "/#/reset/[redacted]", "params": []}},
    {"name": "a high-entropy segment", "url": "/files/Zx9Qm2Lp7Vt4Rk8Wn3Bc6Hy/download", "expect": {"url": "/files/[redacted]/download", "params": []}},
    {"name": "a 20-character segment is long enough", "url": "/k/aB3dE5gH7jK9mN1pQ2sT", "expect": {"url": "/k/[redacted]", "params": []}},
    {"name": "a 19-character segment is not", "url": "/k/aB3dE5gH7jK9mN1pQ2s", "expect": {"url": "/k/aB3dE5gH7jK9mN1pQ2s", "params": []}},
    {"name": "entropy 3.52 bits a character is redacted", "url": "/k/abcdef123456abcdef12", "expect": {"url": "/k/[redacted]", "params": []}},
    {"name": "entropy 3.46 bits a character is kept", "url": "/k/abcdefg1234abcdefg1234", "expect": {"url": "/k/abcdefg1234abcdefg1234", "params": []}},
    {"name": "a long segment without digits is kept", "url": "/docs/getting-started-with-the-product", "expect": {"url": "/docs/getting-started-with-the-product", "params": []}},
    {"name": "a file name of three dotted parts is not a JWT", "url": "/assets/app.min.js", "expect": {"url": "/assets/app.min.js", "params": []}},
    {"name": "a bare query item shaped like a token", "url": "/x?Zx9Qm2Lp7Vt4Rk8Wn3Bc6Hy&a=1", "expect": {"url": "/x?[redacted]&a=1", "params": []}},
    {"name": "only a query", "url": "?token=abc123", "expect": {"url": "?token=[redacted]", "params": ["token"]}},
    {"name": "a mailto query", "url": "mailto:clerk@example.com?subject=Hi&token=abc123", "expect": {"url": "mailto:clerk@example.com?subject=Hi&token=[redacted]", "params": ["token"]}},
    {"name": "a javascript URL stays text", "url": "javascript:alert(1)", "expect": {"url": "javascript:alert(1)", "params": []}},
    {"name": "null stays null", "url": null, "expect": {"url": null, "params": []}}
  ],
  "routePattern": [
    {"name": "a number", "path": "/invoices/1204", "expect": "/invoices/:id"},
    {"name": "a UUID", "path": "/customers/3f2504e0-4f89-11d3-9a0c-0305e82c3301/edit", "expect": "/customers/:id/edit"},
    {"name": "16 hexadecimal characters", "path": "/blobs/deadbeefcafebabe", "expect": "/blobs/:id"},
    {"name": "15 hexadecimal characters stay", "path": "/blobs/deadbeefcafebab", "expect": "/blobs/deadbeefcafebab"},
    {"name": "a long hexadecimal value is an id, not a token", "path": "/blobs/8f14e45fceea167a5a36dedd4bea2543", "expect": "/blobs/:id"},
    {"name": "a JWT segment, with the query and fragment dropped",
     "path": {"join": ["/reset/", "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9", ".", "eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4ifQ", ".", "SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c", "?X-Amz-Signature=a&api_key=k#access_token=t"]},
     "expect": "/reset/:token"},
    {"name": "a high-entropy segment", "path": "/files/Zx9Qm2Lp7Vt4Rk8Wn3Bc6Hy/download", "expect": "/files/:token/download"},
    {"name": "a segment already redacted", "path": "/reset/[redacted]", "expect": "/reset/:token"},
    {"name": "the query is dropped", "path": "/invoices?month=2026-10", "expect": "/invoices"},
    {"name": "a hash route is kept and patterned", "path": "/#/invoices/77?tab=open", "expect": "/#/invoices/:id"},
    {"name": "a full URL gives its path and its plain-word fragment", "path": "http://127.0.0.1:4200/invoices/12#top", "expect": "/invoices/:id#top"},
    {"name": "a plain-word fragment names an overlay of its own", "path": "/invoices#export", "expect": "/invoices#export"},
    {"name": "a fragment with an equals sign is not part of the route", "path": "/invoices#access_token=t", "expect": "/invoices"},
    {"name": "a token-shaped fragment is not part of the route", "path": "/invoices#a8Kd2Lq9ZxRt4Vb7NwYcE3", "expect": "/invoices"},
    {"name": "a fragment of two words is not part of the route", "path": "/invoices#two%20words", "expect": "/invoices"},
    {"name": "a URL without a path is the root", "path": "http://127.0.0.1:4200", "expect": "/"},
    {"name": "words stay", "path": "/settings/legacy", "expect": "/settings/legacy"}
  ]
}
