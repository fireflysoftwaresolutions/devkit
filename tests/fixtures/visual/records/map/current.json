  "journeys": [
    {
      "id": "J:export-month",
      "actor": "finance clerk",
      "task": "Export a month of invoices as CSV",
      "start": "home",
      "budget": 4,
      "keeps": [
        "month"
      ],
      "expect": "A CSV of the month's invoices downloads",
      "steps": [
        {
          "edge": "home>invoices.list",
          "do": [
            "click role=link[name=\"Invoices\"]"
          ],
          "expect": "the invoice list"
        },
        {
          "edge": "invoices.list>invoices.list",
          "do": [
            "select #month 2026-10"
          ],
          "expect": "October's invoices",
          "decision": "the month has invoices, or the empty state"
        },
        {
          "edge": "invoices.list>invoices.export",
          "do": [
            "click role=button[name=\"Export\"]"
          ],
          "expect": "the export dialog, on October"
        },
        {
          "edge": "invoices.export>invoices.done",
          "do": [
            "click role=button[name=\"Download CSV\"]"
          ],
          "expect": "the file is ready"
        },
        {
          "edge": "invoices.done>invoices.list",
          "do": [
            "click role=link[name=\"Back to invoices\"]"
          ],
          "expect": "the list, still on October"
        }
      ]
    },
    {
      "id": "J:find-customer",
      "actor": "finance clerk",
      "task": "Find a customer's unpaid invoices",
      "start": "home",
      "budget": 3,
      "keeps": [],
      "expect": "The customer's unpaid invoices",
      "steps": [
        {
          "edge": "home>customers.list",
          "do": [
            "click role=link[name=\"Customers\"]"
          ],
          "expect": "the customers"
        },
        {
          "edge": "customers.list>customers.detail",
          "do": [
            "click role=link[name=\"Acme Ltd\"]"
          ],
          "expect": "the customer"
        }
      ]
    }
