{
  "_comment": "Which skills a kind of work requires. devkit enforces them: (1) the prompt hook tells the agent which skills to load for the request, (2) briefs for Claude subagents get the skills appended, (3) the Stop hook refuses to finish a turn that changed matching files without loading the skills, once per skill per session. `files` are globs on changed paths; `content` is a regex checked in changed files that match `files`; `prompt` is a regex on the developer's request or a subagent brief. Extend or override with `skills.rules` in ~/.config/devkit/config.json; turn enforcement off with `skills.enforce: false`.",
  "rules": [
    {
      "id": "ui",
      "why": "UI quality: frontend-design for the direction, impeccable for hierarchy, layout, typography, color and the audit",
      "files": [
        "*.html",
        "*.css",
        "*.scss",
        "*.sass",
        "*.less",
        "*.tsx",
        "*.jsx",
        "*.vue",
        "*.svelte",
        "*.component.html",
        "*.component.scss"
      ],
      "content_files": [
        "*.py",
        "*.ts",
        "*.js",
        "*.go",
        "*.rb",
        "*.java",
        "*.php"
      ],
      "content": "<style[\\s>]|<!doctype html|className=|styled\\.|@Component\\(",
      "prompt": "\\b(ui|ux|frontend|front-end|landing( page)?|css|tailwind|layout|interfaz|diseño visual)\\b|\\b(design|redesign|build|create|improve|polish|restyle|style|diseñ\\w*|rediseñ\\w*|mejor\\w*|maquet\\w*|crea\\w*|constru\\w*)\\W+(\\w+\\W+){0,4}(dashboard|page|p[aá]gina|screen|pantalla|component|componente|form|formulario|modal|view|vista)s?\\b",
      "skills": {
        "claude": [
          "frontend-design",
