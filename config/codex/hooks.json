{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "'{{DEVKIT}}/bin/dev' hook session-start --agent codex",
            "timeout": 30,
            "statusMessage": "devkit: loading project context"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch|spawn_agent)$",
        "hooks": [
          {
            "type": "command",
            "command": "'{{DEVKIT}}/bin/dev' hook guard --agent codex",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'{{DEVKIT}}/bin/dev' hook stop --agent codex",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'{{DEVKIT}}/bin/dev' hook session-end --agent codex",
            "timeout": 3
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'{{DEVKIT}}/bin/dev' hook prompt --agent codex",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "'{{DEVKIT}}/bin/dev' hook post-tool --agent codex",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'{{DEVKIT}}/bin/dev' hook subagent-start --agent codex",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'{{DEVKIT}}/bin/dev' hook subagent-stop --agent codex",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'{{DEVKIT}}/bin/dev' hook pre-compact --agent codex",
            "timeout": 15
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'{{DEVKIT}}/bin/dev' hook post-compact --agent codex",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
