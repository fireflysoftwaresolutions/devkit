{
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "skipDangerousModePermissionPrompt": true,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "cleanupPeriodDays": 14,
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "300000",
    "DOCKER_HOST": "unix://{{HOME}}/.colima/default/docker.sock",
    "TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE": "/var/run/docker.sock",
    "NG_CLI_ANALYTICS": "false",
    "NEXT_TELEMETRY_DISABLED": "1",
    "SUPERPOWERS_DISABLE_TELEMETRY": "1",
    "ENABLE_STOP_REVIEW": "0",
    "ENABLE_COMMIT_REVIEW": "0",
    "CLAUDE_SECURITY_SCAN_TIP": "off",
    "TRIVY_DISABLE_TELEMETRY": "true",
    "TRIVY_SKIP_VERSION_CHECK": "true",
    "SEMGREP_SEND_METRICS": "off",
    "SYFT_CHECK_FOR_APP_UPDATE": "false",
    "GRYPE_CHECK_FOR_APP_UPDATE": "false"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'{{DEVKIT}}/bin/dev' hook session-start --agent claude",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "'{{DEVKIT}}/bin/dev' hook guard --agent claude",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'{{DEVKIT}}/bin/dev' hook stop --agent claude",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'{{DEVKIT}}/bin/dev' hook session-end --agent claude",
            "timeout": 10
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "matcher": "user_settings|project_settings|local_settings",
        "hooks": [
          {
            "type": "command",
            "command": "'{{DEVKIT}}/bin/dev' hook config-change --agent claude",
            "timeout": 15
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'{{DEVKIT}}/bin/dev' hook instructions-loaded --agent claude",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'{{DEVKIT}}/bin/dev' hook prompt --agent claude",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Agent|Task|Monitor|Write|Edit|MultiEdit|WebFetch|WebSearch|AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "'{{DEVKIT}}/bin/dev' hook post-tool --agent claude",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Agent|Task|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "'{{DEVKIT}}/bin/dev' hook post-tool-failure --agent claude",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'{{DEVKIT}}/bin/dev' hook subagent-start --agent claude",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'{{DEVKIT}}/bin/dev' hook subagent-stop --agent claude",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "fastModePerSessionOptIn": true
}
