      "label": "React", "stack": "node",
      "extensions": {"skill": ["react-best-practices", "composition-patterns"]}
    },
    "nextjs": {
      "label": "Next.js", "stack": "node",
      "extensions": {"skill": ["react-best-practices", "composition-patterns"]}
    },
    "nestjs": {"label": "NestJS", "stack": "node"},
    "spring": {
      "label": "Spring Boot", "stack": "java",
      "extensions": {"skill": ["java-springboot", "spring-boot-testing", "spring-security", "spring-observability"]}
