{
  "name": "delivery",
  "kind": "flow",
  "title": "Local-first delivery: one push, one CI run",
  "desc": "Feature branches are integrated on one local integration or release branch, which runs the same commands as CI locally. Only when the local suite is green is the branch pushed once and opened as one pull request, so CI runs once. If CI fails, the failure is reproduced and fixed locally before the next push. A green CI run is merged, tagged with a CalVer version and released, and the published artefact is verified.",
  "legend": [
    {
      "label": "the one push",
      "style": "primary"
    },
    {
      "label": "fix locally",
      "style": "dashed"
    }
  ],
  "nodes": [
    {
      "id": "branches",
      "label": "Feature branches",
      "sub": "feat/… · fix/…",
      "col": 0,
      "row": 0
    },
    {
      "id": "integration",
      "label": "Integration branch",
      "sub": "release/26.11.4 · local",
      "col": 1,
      "row": 0
    },
    {
      "id": "local",
      "label": "Local CI equivalent",
      "sub": "dev ci · lint · tests · build",
      "col": 2,
      "row": 0
    },
    {
      "id": "push",
      "label": "One push, one PR",
      "sub": "gh pr create · checks --watch",
      "col": 2,
      "row": 1
    },
    {
      "id": "ci",
      "label": "GitHub CI",
      "sub": "runs once",
      "col": 1,
      "row": 1,
      "family": "steel"
    },
    {
      "id": "release",
      "label": "Merge · tag · release",
      "sub": "vYY.MM.PATCH",
      "col": 0,
      "row": 1
    },
    {
      "id": "verify",
      "label": "Verify the artefact",
      "sub": "download · install · smoke test",
      "col": 0,
      "row": 2
    }
  ],
  "edges": [
    {
      "from": "branches",
      "to": "integration",
      "label": "merge locally"
    },
    {
      "from": "integration",
      "to": "local",
      "label": "run"
    },
    {
      "from": "local",
      "to": "integration",
      "label": "red: fix locally",
      "style": "dashed",
      "from_side": "top",
      "to_side": "top",
      "via": [
        [
          1.5,
          -0.8
        ]
      ]
    },
    {
      "from": "local",
      "to": "push",
      "label": "green",
      "style": "primary"
    },
    {
      "from": "push",
      "to": "ci",
      "style": "primary"
    },
    {
      "from": "ci",
      "to": "release",
      "label": "green",
      "style": "primary"
    },
    {
      "from": "ci",
      "to": "integration",
      "label": "red: reproduce and fix locally",
      "style": "dashed",
      "from_side": "top",
      "to_side": "bottom"
    },
    {
      "from": "release",
      "to": "verify"
    }
  ]
}
