{
  "name": "work-item-lifecycle",
  "kind": "state",
  "title": "Life of a work item",
  "desc": "A work item starts as todo when dev task add creates it. dev task start (or claim) takes an 8-hour lock and makes it doing; the lock is renewed only while a session works on the item's branch. release or delegate gives the lock back and returns the item to todo, and so does a lock that runs out. done releases the lock and closes the item, and so does dev pr merge of the item's branch. block, with a reason, marks an item blocked, and unblock returns it to todo (or to doing while it is still claimed). cancel, with a reason, closes any open item.",
  "equal_widths": "all",
  "nodes": [
    {
      "id": "start",
      "initial": true,
      "col": 1,
      "row": 0
    },
    {
      "id": "todo",
      "label": "Todo",
      "sub": "unclaimed",
      "col": 1,
      "row": 1
    },
    {
      "id": "doing",
      "label": "Doing",
      "sub": "claimed: 8 h lock",
      "col": 2,
      "row": 1,
      "emphasis": true
    },
    {
      "id": "done",
      "label": "Done",
      "sub": "lock released",
      "col": 3,
      "row": 1,
      "family": "olive"
    },
    {
      "id": "blocked",
      "label": "Blocked",
      "sub": "with a reason",
      "col": 1,
      "row": 2
    },
    {
      "id": "cancelled",
      "label": "Cancelled",
      "sub": "with a reason",
      "col": 2,
      "row": 3,
      "family": "olive"
    }
  ],
  "groups": [
    {
      "id": "open",
      "title": "Open",
      "nodes": [
        "todo",
        "doing",
        "blocked"
      ],
      "dashed": true
    }
  ],
  "edges": [
    {
      "from": "start",
      "to": "todo",
      "label": "add"
    },
    {
      "from": "todo",
      "to": "doing",
      "label": "start · claim"
    },
    {
      "from": "doing",
      "to": "todo",
      "label": "release · delegate · lock runs out",
      "style": "dashed",
      "from_side": "top",
      "to_side": "top"
    },
    {
      "from": "doing",
      "to": "done",
      "label": "done · branch merged"
    },
    {
      "from": "todo",
      "to": "blocked",
      "label": "block --why"
    },
    {
      "from": "blocked",
      "to": "todo",
      "label": "unblock",
      "style": "dashed",
      "from_side": "left",
      "to_side": "left"
    },
    {
      "from": "open",
      "to": "cancelled",
      "label": "cancel --why",
      "from_side": "bottom",
      "to_side": "top"
    }
  ]
}
