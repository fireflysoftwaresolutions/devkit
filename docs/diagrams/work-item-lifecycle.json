{
  "name": "work-item-lifecycle",
  "kind": "state",
  "title": "Life of a work item",
  "desc": "A work item starts as todo when dev task add creates it. dev task start (or claim) takes an 8-hour lock and makes it doing; release or delegate gives the lock back and returns it to todo, and done releases the lock and closes the item. A lock that is not renewed for 8 hours expires: the item stays doing, unlocked, and anyone may claim it. block, with a reason, marks an item blocked, and unblock returns it to todo (or to doing while it is still claimed). cancel, with a reason, closes any open item.",
  "equal_widths": "all",
  "nodes": [
    {
      "id": "start",
      "initial": true,
      "col": 1,
      "row": 0
    },
    {
      "id": "todo",
      "label": "Todo",
      "sub": "unclaimed",
      "col": 1,
      "row": 1
    },
    {
      "id": "doing",
      "label": "Doing",
      "sub": "claimed: 8 h lock",
      "col": 2,
      "row": 1,
      "emphasis": true
    },
    {
      "id": "done",
      "label": "Done",
      "sub": "lock released",
      "col": 3,
      "row": 1,
      "family": "olive"
    },
    {
      "id": "blocked",
      "label": "Blocked",
      "sub": "with a reason",
      "col": 1,
      "row": 2
    },
    {
      "id": "expired",
      "label": "Doing, unlocked",
      "sub": "not renewed for 8 h",
      "col": 2,
      "row": 2
    },
    {
      "id": "cancelled",
      "label": "Cancelled",
      "sub": "with a reason",
      "col": 1.5,
      "row": 3,
      "family": "olive"
    }
  ],
  "groups": [
    {
      "id": "open",
      "title": "Open",
      "nodes": [
        "todo",
        "doing",
        "blocked",
        "expired"
      ],
      "dashed": true
    }
  ],
  "edges": [
    {
      "from": "start",
      "to": "todo",
      "label": "add"
    },
    {
      "from": "todo",
      "to": "doing",
      "label": "start · claim"
    },
    {
      "from": "doing",
      "to": "todo",
      "label": "release · delegate",
      "style": "dashed",
      "from_side": "top",
      "to_side": "top"
    },
    {
      "from": "doing",
      "to": "done",
      "label": "done"
    },
    {
      "from": "todo",
      "to": "blocked",
      "label": "block --why"
    },
    {
      "from": "blocked",
      "to": "todo",
      "label": "unblock",
      "style": "dashed",
      "from_side": "left",
      "to_side": "left"
    },
    {
      "from": "doing",
      "to": "expired",
      "label": "lock expires"
    },
    {
      "from": "expired",
      "to": "doing",
      "label": "claim",
      "style": "dashed",
      "from_side": "right",
      "to_side": "right"
    },
    {
      "from": "open",
      "to": "cancelled",
      "label": "cancel --why",
      "from_side": "bottom",
      "to_side": "top"
    }
  ]
}
