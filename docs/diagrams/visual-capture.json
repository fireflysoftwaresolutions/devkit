      "label": "Capture driver",
      "sub": "Playwright",
      "family": "firefly",
      "col": 1,
      "row": 1
    },
    {
      "id": "redact",
      "label": "Redaction",
      "sub": "in memory",
      "family": "firefly",
      "emphasis": true,
      "col": 2,
      "row": 1
    },
    {
      "id": "store",
      "label": "Local store",
      "sub": "pictures, descriptions",
      "shape": "store",
      "family": "slate",
      "col": 3,
      "row": 1
    },
    {
      "id": "never",
      "label": "Never stored",
      "sub": "form values, cookies",
      "shape": "note",
      "family": "note",
      "col": 2,
