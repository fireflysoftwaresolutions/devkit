      "id": "you",
      "label": "You",
      "family": "neutral"
    },
    {
      "id": "agent",
      "label": "Agent",
      "sub": "Claude Code · Codex"
    },
    {
      "id": "hooks",
      "label": "devkit hooks",
      "family": "firefly"
    },
    {
      "id": "handoff",
      "label": "Handoff repo",
      "family": "slate"
    },
    {
      "id": "github",
      "label": "GitHub",
      "family": "steel"
    }
  ],
